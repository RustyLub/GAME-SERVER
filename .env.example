# Public Firebase Web App configuration for the dedicated GAME-SERVER project.
# These values are visible in the browser bundle and are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public HTTPS base URL of the Steam authentication backend (not a secret).
VITE_API_BASE_URL=
