PORT=8080
NODE_ENV=production
FRONTEND_ORIGIN=https://rusty-lub.online
BACKEND_PUBLIC_URL=https://YOUR-BACKEND-DOMAIN
FIREBASE_PROJECT_ID=rustylub
FIREBASE_SERVICE_ACCOUNT_EMAIL=YOUR-CLOUD-RUN-SERVICE-ACCOUNT@rustylub.iam.gserviceaccount.com
# Optional: Steam Web API key is only needed to show the player's current nickname and avatar.
STEAM_API_KEY=
# Platega checkout — keep both credentials server-side only.
PLATEGA_API_BASE=https://api.eu.payplatform.cc
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Set the approved VIP price in whole RUB before enabling checkout.
VIP_PRICE_RUB=
# Configure this exact HTTPS URL in Platega Settings -> Callback URLs:
# https://YOUR-BACKEND-DOMAIN/payments/platega/callback
# Shared bearer secret used only between the Carbon plugin and this backend.
CARBON_SYNC_SECRET=
