PORT=8080
NODE_ENV=production
FRONTEND_ORIGIN=https://rusty-lub.online
BACKEND_PUBLIC_URL=https://YOUR-CLOUD-RUN-SERVICE-URL
# Use the dedicated Firebase project selected for GAME-SERVER. Do not guess or
# reuse the legacy website project ID.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_EMAIL=YOUR-CLOUD-RUN-SERVICE-ACCOUNT@YOUR-PROJECT.iam.gserviceaccount.com
# Optional. Store in Secret Manager if configured; Steam sign-in works without it.
STEAM_API_KEY=
