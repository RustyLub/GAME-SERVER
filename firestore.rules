rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if ownsProfile(userId);
      allow list, create, delete: if false;
      allow update: if ownsProfile(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customDisplayName'])
        && request.resource.data.customDisplayName is string
        && request.resource.data.customDisplayName.size() >= 2
        && request.resource.data.customDisplayName.size() <= 24;
    }

    match /orders/{orderId} {
      allow get, list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
