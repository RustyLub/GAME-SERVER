rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The trusted Steam backend creates and updates profiles with Firebase Admin.
    // A signed-in user may fetch exactly their own profile, but cannot list users
    // or write any profile field from the browser.
    match /users/{userId} {
      allow get: if ownsProfile(userId);
      allow list, create, update, delete: if false;
    }

    // All other collections (including payment, entitlement and internal queues)
    // are server-only and remain inaccessible to Firebase client SDKs.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
